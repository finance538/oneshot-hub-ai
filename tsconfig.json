{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "shared",
    "db",
    "netlify",
    "vite.config.ts",
    "scripts/tools-prerender.ts",
    "tests",
    "drizzle.config.ts"
  ]
}
